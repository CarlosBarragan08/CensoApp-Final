<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CensoApp.Views.DetallePage"
             Title="Detalle del Establecimiento"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121214}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- TARJETA PRINCIPAL DE DATOS -->
            <Border Padding="16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}" 
                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#2E2E38}" StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="8">
                    <!-- TÍTULOS PRINCIPALES -->
                    <Label x:Name="LblNombreComercial" FontSize="22" FontAttributes="Bold" />
                    <Label x:Name="LblRazonSocial" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#475569, Dark=#D4D4D8}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2E2E38}" Margin="0,4" />

                    <!-- INFORMACIÓN GENERAL -->
                    <Label Text="INFORMACIÓN GENERAL" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}"/>
                    <Label x:Name="LblTipoDocumento" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblNit" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblInscripcion" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblRepresentante" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblTipoSujeto" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblEstado" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2E2E38}" Margin="0,4" />

                    <!-- UBICACIÓN Y CONTACTO -->
                    <Label Text="UBICACIÓN Y CONTACTO" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}"/>
                    <Label x:Name="LblDireccion" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblMunicipio" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblDepartamento" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblArea" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblTelefono" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblCorreo" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E2E8F0, Dark=#2E2E38}" Margin="0,4" />

                    <!-- CLASIFICACIÓN Y REGLAMENTACIÓN -->
                    <!-- CLASIFICACIÓN Y REGLAMENTACIÓN -->
                    <Label Text="CLASIFICACIÓN Y REGLAMENTACIÓN" FontSize="11" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}"/>
                    <Label x:Name="LblTipoEstablecimiento" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblActividadPrincipal" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblRiesgo" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblAutDec1500" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblResAutorizacion" FontSize="13" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                    <Label x:Name="LblEstadoSanitarioActual" FontSize="13" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F0}" />
                </VerticalStackLayout>
            </Border>

            <!-- BOTÓN REGISTRAR NUEVA VISITA -->
            <Button Text="+ Registrar Nueva Visita" Clicked="OnNuevaVisitaClicked" BackgroundColor="#F59E0B" TextColor="White" FontAttributes="Bold" FontSize="15" CornerRadius="8" HeightRequest="48" />

            <!-- HISTORIAL DE VISITAS -->
            <Label Text="HISTORIAL DE VISITAS REALIZADAS" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0284C7, Dark=#38BDF8}" Margin="0,8,0,0" />
            <CollectionView x:Name="ListaVisitas" EmptyView="No hay visitas registradas para este establecimiento.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,4,0,8" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#2E2E38}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <Label Text="{Binding NumeroVisitaTexto}" FontAttributes="Bold" FontSize="15" TextColor="#F59E0B" Grid.Column="0" />
                                    <Label Text="{Binding FechaVisita, StringFormat='Fecha: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#A1A1AA}" HorizontalOptions="End" Grid.Column="1" />
                                </Grid>
                                <Label Text="{Binding CumplimientoYConceptoTexto}" FontSize="13" FontAttributes="Bold" TextColor="{Binding ColorConcepto}" />
                                <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A30}" Margin="0,2" />
                                <Label Text="{Binding FuncionariosTexto}" FontSize="12" TextColor="{AppThemeBinding Light=#475569, Dark=#D4D4D8}" />
                                <Label Text="{Binding ObjetivoTexto}" FontSize="12" TextColor="{AppThemeBinding Light=#475569, Dark=#D4D4D8}" />
                                <Label Text="{Binding DenunciasTexto}" FontSize="12" TextColor="{AppThemeBinding Light=#475569, Dark=#D4D4D8}" />
                                <Label Text="{Binding EtaTexto}" FontSize="12" TextColor="{AppThemeBinding Light=#475569, Dark=#D4D4D8}" />
                                <Label Text="{Binding MedidaTexto}" FontSize="12" TextColor="{AppThemeBinding Light=#475569, Dark=#D4D4D8}" />
                                <Label Text="{Binding ObservacionesTexto}" FontSize="12" FontAttributes="Italic" TextColor="{AppThemeBinding Light=#64748B, Dark=#A1A1AA}" />
                                <VerticalStackLayout IsVisible="{Binding TieneDocumentos}" Spacing="4" Margin="0,4,0,0">
                                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A30}" />
                                    <Button Text="📄 Ver / Descargar Documento Adjunto" 
            Clicked="OnVerDocumentosClicked" 
            CommandParameter="{Binding DocumentoAdjunto}"
            BackgroundColor="#0284C7" TextColor="White" FontSize="12" FontAttributes="Bold"
            HeightRequest="36" CornerRadius="6" HorizontalOptions="Start"/>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- BOTONES DE ACCIÓN -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,16">
                <Button Text="Editar Establecimiento" Clicked="OnEditarClicked" BackgroundColor="#3B82F6" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="48" Grid.Column="0" />
                <Button Text="Eliminar Registro" Clicked="OnEliminarClicked" BackgroundColor="#EF4444" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="48" Grid.Column="1" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>