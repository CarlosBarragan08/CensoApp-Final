<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CensoApp.Views.NuevaVisitaPage"
             Title="Registrar Nueva Visita"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121214}">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">
            <Label x:Name="LblTituloVisita" FontSize="18" FontAttributes="Bold" TextColor="#F59E0B" />

            <VerticalStackLayout Spacing="4">
                <Label Text="Fecha Visita:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <DatePicker x:Name="DpFechaVisita" Format="dd/MM/yyyy" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Porcentaje de Cumplimiento (%):" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Entry x:Name="TxtPorcentaje" Placeholder="0 a 100" Keyboard="Numeric" TextChanged="OnPorcentajeTextChanged" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#52525B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Concepto Sanitario (Autocalculado):" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#2E2E38}" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Label x:Name="LblConceptoAuto" Text="INGRESE UN PORCENTAJE" FontAttributes="Bold" FontSize="14" TextColor="#64748B" />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Inspectores / Funcionarios:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Entry x:Name="TxtFuncionarios" Placeholder="Nombres de los inspectores" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#52525B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Motivo de la Visita:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Picker x:Name="PckObjetivo" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}" SelectedIndexChanged="OnObjetivoSelectedIndexChanged">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>PROGRAMACIÓN</x:String>
                            <x:String>SOLICITUD DEL INTERESADO</x:String>
                            <x:String>ASOCIADA A PETICIONES, QUEJAS Y RECLAMOS</x:String>
                            <x:String>SOLICITUD OFICIAL</x:String>
                            <x:String>EVENTO DE INTERÉS EN SALUD PÚBLICA</x:String>
                            <x:String>SOLICITUD DE PRÁCTICA DE PRUEBAS / PROCESOS SANCIONATORIOS ADMIN.</x:String>
                            <x:String>OTRO</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="SeccionOtroObjetivo" Spacing="4" IsVisible="False">
                <Label Text="Especifique otro motivo:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Entry x:Name="TxtOtroObjetivo" Placeholder="Escriba el motivo específico" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#52525B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                <VerticalStackLayout Spacing="4" Grid.Column="0">
                    <Label Text="¿Tiene Denuncias?" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                    <Picker x:Name="PckDenuncias" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>NO</x:String>
                                <x:String>SI</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="4" Grid.Column="1">
                    <Label Text="¿Involucrado en ETA?" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                    <Picker x:Name="PckEta" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>NO</x:String>
                                <x:String>SI</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
            </Grid>

            <!-- SECCIÓN DESPLEGABLE DE MEDIDAS SANITARIAS MÚLTIPLES -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Medida Sanitaria Aplicada:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>

                <!-- Encabezado del Dropdown -->
                <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#2E2E38}" Padding="12,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleMedidasClicked"/>
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="*, Auto">
                        <Label x:Name="LblMedidasSeleccionadas" Text="NO APLICA" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                        <Label Text="▼" FontSize="11" TextColor="{AppThemeBinding Light=#64748B, Dark=#A1A1AA}" Grid.Column="1" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Panel Oculto con CheckBoxes -->
                <Border x:Name="SeccionDesplegableMedidas" IsVisible="False" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}" Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#2E2E38}" Padding="10" Margin="0,2,0,0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="4">
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkNoAplica" IsChecked="True" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="NO APLICA" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkClausuraTotal" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="CLAUSURA TEMPORAL TOTAL" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkClausuraParcial" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="CLAUSURA TEMPORAL PARCIAL" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkSuspensionParcial" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="SUSPENSIÓN PARCIAL DE TRABAJOS O SERVICIOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkSuspensionTotal" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="SUSPENSIÓN TOTAL DE TRABAJOS O SERVICIOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkDecomiso" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="DECOMISO DE ARTICULOS O PRODUCTOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkDestruccion" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="DESTRUCCIÓN DE ARTICULOS O PRODUCTOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkDesnaturalizacion" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="DESNATURALIZACIÓN DE ARTICULOS O PRODUCTOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>
                        
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkCongelacionTemporal" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="CONGELACIÓN TEMPORAL DE LA VENTA O EMPLEO DE PRODUCTOS Y OBJETOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkSuspensionTemporalVenta" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="SUSPENSIÓN TEMPORAL DE LA VENTA O EMPLEO DE PRODUCTOS Y OBJETOS" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox x:Name="ChkOtraMedida" CheckedChanged="OnMedidaCheckedChanged"/>
                            <Label Text="OTRA MEDIDA" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- CAMPO DINÁMICO PARA ESPECIFICAR OTRA MEDIDA SANITARIA -->
            <VerticalStackLayout x:Name="SeccionOtraMedida" Spacing="4" IsVisible="False">
                <Label Text="Especifique otra medida sanitaria:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Entry x:Name="TxtOtraMedida" Placeholder="Escriba la medida sanitaria" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#52525B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
            </VerticalStackLayout>

            <!-- DOCUMENTO ADJUNTO (ACTA IVC, INSCRIPCIÓN, ETC.) -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Documento Adjunto (Acta IVC, Inscripción, etc.):" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Entry x:Name="TxtDocumentoAdjunto" IsReadOnly="True" Placeholder="Ningún archivo seleccionado (puedes elegir varios)" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#52525B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
                    <Button Grid.Column="1" Text="Cargar Archivo" Clicked="OnSeleccionarDocumentoClicked" BackgroundColor="#3B82F6" TextColor="White" FontAttributes="Bold" CornerRadius="6" HeightRequest="44"/>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Observaciones:" FontSize="13" TextColor="{AppThemeBinding Light=#475569, Dark=#A1A1AA}"/>
                <Editor x:Name="TxtObservaciones" Placeholder="Escriba aquí las observaciones..." HeightRequest="80" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#52525B}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E22}"/>
            </VerticalStackLayout>

            <Button Text="Guardar Visita" Clicked="OnGuardarClicked" BackgroundColor="#22C55E" TextColor="White" FontAttributes="Bold" FontSize="15" CornerRadius="8" HeightRequest="48" Margin="0,10,0,20"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>